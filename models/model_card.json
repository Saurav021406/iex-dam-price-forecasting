{
  "name": "GridCast India - day-ahead DAM price forecaster",
  "version": "1.0",
  "created": "2026-11-26",
  "model": "XGBoost regressor (tuned)",
  "target": "IEX Day-Ahead Market MCP, Rs/kWh, 96 blocks per day",
  "forecast_protocol": "Day-ahead: uses only information up to the previous day 23:45; output clipped to [0, ceiling]; ceiling = 10 Rs/kWh",
  "features": [
    "mcp_lag96",
    "mcp_lag192",
    "mcp_lag288",
    "mcp_lag672",
    "sameblock_mean7",
    "sameblock_std7",
    "sameblock_max7",
    "y_mean",
    "y_std",
    "y_max",
    "y_min",
    "y_last",
    "y_cap_share",
    "y_mean7",
    "demand_lag96",
    "y_demand_mean",
    "supply_lag96",
    "y_supply_mean",
    "mcv_lag96",
    "y_mcv_mean",
    "bid_ratio_lag96",
    "block",
    "hour",
    "dow",
    "month",
    "is_weekend",
    "block_sin",
    "block_cos"
  ],
  "hyperparameters": {
    "tree_method": "hist",
    "n_jobs": -1,
    "random_state": 42,
    "max_depth": 5,
    "learning_rate": 0.03,
    "subsample": 0.6,
    "colsample_bytree": 1.0,
    "min_child_weight": 5,
    "reg_lambda": 10.0,
    "objective": "reg:absoluteerror"
  },
  "n_trees": 302,
  "evaluation_model": {
    "trained_on": "2023-01-08 00:00:00 to 2025-06-30 23:45",
    "test_period": "2025-07-01 00:00 to 2025-10-01 23:45:00",
    "test_hourly": {
      "MAE": 0.502,
      "RMSE": 0.877,
      "MAPE_%": 27.586,
      "sMAPE_%": 17.031,
      "MASE": 0.732
    },
    "test_15min": {
      "MAE": 0.518,
      "RMSE": 0.954,
      "MAPE_%": 30.111,
      "sMAPE_%": 17.516,
      "MASE": 0.742
    }
  },
  "deployment_model": {
    "file": "xgboost_deploy.json",
    "trained_on": "2023-01-08 00:00:00 to 2025-10-01 23:45:00",
    "note": "same hyperparameters, refit on all available data"
  },
  "libraries": {
    "xgboost": "3.4.1",
    "pandas": "2.3.3",
    "numpy": "2.1.3",
    "scikit-learn": "1.6.1"
  },
  "known_limitations": [
    "One exchange (IEX DAM) and one 93-day test period",
    "Depends heavily on yesterday's same-block price (about 72% of SHAP importance)",
    "Weaker when the price level shifts from the day before (see Part 15)",
    "Data ends 2025-10-01; no weather or fuel-price inputs"
  ]
}